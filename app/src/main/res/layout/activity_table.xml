<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TableActivity"
    android:padding="16dp">

    <TableRow>
        <TextView android:padding="8dp" android:text="Name" android:textStyle="bold" />
        <TextView android:padding="8dp" android:text="Marks" android:textStyle="bold" />
        <TextView android:padding="8dp" android:text="Grade" android:textStyle="bold" />
    </TableRow>
    <TableRow>
        <TextView android:padding="8dp" android:text="Aisyah" />
        <TextView android:padding="8dp" android:text="92" />
        <TextView android:padding="8dp" android:text="A" />
    </TableRow>
    <TableRow>
        <TextView android:padding="8dp" android:text="Farid" />
        <TextView android:padding="8dp" android:text="78" />
        <TextView android:padding="8dp" android:text="B+" />
    </TableRow>
    <TableRow>
        <TextView android:padding="8dp" android:text="Mei Ling" />
        <TextView android:padding="8dp" android:text="85" />
        <TextView android:padding="8dp" android:text="A-" />
    </TableRow>


    <TableRow>
        <TextView android:text="Name" android:padding="8dp" />
        <EditText android:hint="Enter Name" />
    </TableRow>

    <TableRow>
        <TextView android:text="Email" android:padding="8dp" />
        <EditText android:hint="Enter Email" />
    </TableRow>

    <TableRow>
        <TextView android:text="Phone" android:padding="8dp" />
        <EditText android:hint="Enter Phone" />
    </TableRow>

    <TableRow>
        <Button
            android:text="Submit"
            android:layout_span="2"
            android:layout_gravity="center_horizontal" />
    </TableRow>


</TableLayout>